# Keep the loadable extension bundle in Git so `git pull` updates also provide a ready-to-load build.
/dist/*
!/dist/extension/
/dist/extension/*
!/dist/extension/**

# Browser test profiles / screenshots
/test-artifacts/

# Dependencies and local configuration
/node_modules/
/.dsh/
.env
.env.*
!.env.example
*.pem
*.key

# Logs and editor / OS files
*.log
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
